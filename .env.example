# Reference template only; Node does not load this file automatically.
# Set values in PowerShell as shown in README.md.
# Sandbox app credentials: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: Webhook ID from the PayPal Sandbox app settings
PAYPAL_WEBHOOK_ID=
# Optional: email of a PayPal Sandbox personal recipient for the $1 test award
PAYPAL_PAYOUT_TEST_EMAIL=

# Optional local LLM (install Ollama and pull this model first; no API key or usage fee)
OLLAMA_MODEL=qwen2.5:1.5b
PORT=4173
HOST=127.0.0.1
